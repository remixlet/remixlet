{
  "minimum_chrome_version": "138",
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "permissions": [
    "userScripts",
    "sidePanel",
    "offscreen",
    "clipboardWrite",
    "notifications",
    "declarativeNetRequestWithHostAccess"
  ],
  "side_panel": {
    "default_path": "panel/index.html"
  }
}
