{
  "manifest_version": 3,
  "name": "Remixlet",
  "version": "0.1.0",
  "description": "Remix any website with a sentence. Your agent writes small, inspectable, reversible site mods — remixlets.",
  "permissions": [
    "scripting",
    "storage",
    "unlimitedStorage",
    "declarativeNetRequest",
    "webRequest",
    "webNavigation",
    "tabs",
    "alarms"
  ],
  "host_permissions": ["<all_urls>"],
  "content_security_policy": {
    "extension_pages": "default-src 'none'; script-src 'self'; object-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src https: http://localhost:* http://127.0.0.1:* data:; base-uri 'none'; form-action 'none'"
  },
  "web_accessible_resources": [
    {
      "resources": ["panel/index.html"],
      "matches": ["<all_urls>"],
      "use_dynamic_url": true
    },
    {
      "resources": ["panel/files/space-grotesk-*.woff2"],
      "matches": ["<all_urls>"]
    },
    {
      "resources": ["oauth-callback.html"],
      "matches": ["https://auth.openai.com/*", "http://localhost/*"]
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Remixlet",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "commands": {
    "open-panel": {
      "suggested_key": { "default": "Ctrl+J", "mac": "Command+J" },
      "description": "Open the Remixlet panel"
    }
  }
}
